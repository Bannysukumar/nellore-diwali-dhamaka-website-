# Copy to `.env.production` (git-ignored). Used by `npm run build:prod`.
# VITE_FIREBASE_PROJECT_ID must equal the "prod" alias in .firebaserc or the
# build fails.
#
# Every VITE_* value is compiled into the public JavaScript bundle. Only put the
# Firebase *web* app configuration here — never service-account keys, payment
# gateway secrets or other credentials.
VITE_APP_MODE=live

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# reCAPTCHA Enterprise site key registered for App Check (public). Empty = App Check off.
VITE_APPCHECK_RECAPTCHA_SITE_KEY=
