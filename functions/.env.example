# Server-side settings for Cloud Functions.
#
# Firebase loads `functions/.env` for every project and `functions/.env.<project-id>`
# for that project only (for example `functions/.env.uwgea32`). Those real files are
# git-ignored. These values are visible to anyone with access to the deployed
# functions' configuration: do not place private keys or payment credentials here —
# use Secret Manager (`firebase functions:secrets:set`) for real secrets.

# Reject callable requests that do not carry a valid App Check token.
# Set to true only after App Check (reCAPTCHA Enterprise) is registered for the web
# app and VITE_APPCHECK_RECAPTCHA_SITE_KEY is set in the matching web build;
# otherwise every callable will fail with "unauthenticated".
ENFORCE_APP_CHECK=false

# Instances kept running for each customer callable (sign-in, buy tickets, spin,
# add money, send money) so taps never wait for a cold start. Each warm instance
# is billed around the clock (roughly US$8 a month per function per region), so
# set 1 for busy sales periods only and back to 0 afterwards, then redeploy.
WARM_INSTANCES=0
